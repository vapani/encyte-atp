{
  // Cloudflare Worker that fronts the ATP form container.
  // Deploy with:  npx wrangler deploy      (Docker must be running)
  "name": "encyte-atp",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  "containers": [
    {
      // Three people share one instance; there is no per-user state to keep
      // apart, because engagement records go to GitHub rather than to disk.
      "max_instances": 1,
      "class_name": "AtpContainer",
      "image": "./Dockerfile"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "ATP_CONTAINER",
        "class_name": "AtpContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      // Containers require new_sqlite_classes, not new_classes.
      "new_sqlite_classes": ["AtpContainer"]
    }
  ],

  "observability": {
    "enabled": true
  },

  // TEMPORARY: the form is open to anyone with the link. Chosen 29 Sep 2026 to get
  // the fixed form live before a password is set. To close it: delete this block,
  // run `npx wrangler secret put ATP_PASSWORD`, then `npx wrangler deploy`.
  "vars": {
    "ATP_AUTH": "off"
  }

  // ATP_GITHUB_TOKEN is NOT set here. It is a secret:
  //   npx wrangler secret put ATP_GITHUB_TOKEN
}
